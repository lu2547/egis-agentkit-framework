# 首次初始化参数。复制为受保护的 init.env，由运维填写并导出；不含实际密钥。
# 这些是初始化脚本参数；应用运行时配置仍以 Nacos agentkit.yaml 为准。

# 已由运维挂载的 NAS，以及 API 账号能访问的业务目录。
NAS_MOUNTPOINT=/mnt/company-nas
NAS_ROOT=/mnt/company-nas/agentkit
SKILL_STORAGE_ROOT=/mnt/company-nas/agentkit/skill-uploads
NAS_DIR_MODE=0750

# PostgreSQL 客户端使用标准 PG* 变量；数据库和账号由平台预先提供。
PGHOST=pg.company.internal
PGPORT=5432
PGDATABASE=agentscope
PGUSER=agentkit
# 密码使用平台密钥注入 PGPASSWORD 或受保护的 PGPASSFILE，不在这里填写。
# PGSSLMODE=verify-full
# PGSSLROOTCERT=/path/to/pg-ca.pem

# Redis 保存集群会话事件回放。连接探针使用 REDISCLI_AUTH，应用密码由 Nacos passwordEnv 引用。
REDIS_HOST=redis.company.internal
REDIS_PORT=6379
# REDIS_USER=default
REDIS_DB=0
REDIS_TLS=false
# REDIS_CA_FILE=/path/to/redis-ca.pem
# REDIS_CLI=/path/to/redis-cli

# 与 Nacos client.kafka.connection/topics 中的值对应。
KAFKA_BOOTSTRAP_SERVERS=kafka.company.internal:9092
KAFKA_TOPIC_PREFIX=egis-agentkit
KAFKA_TOPIC_PARTITIONS=8
KAFKA_TOPIC_REPLICATION_FACTOR=1
# KAFKA_TOPICS_BIN=/path/to/kafka/bin/kafka-topics.sh
# KAFKA_CLIENT_PROPERTIES=/path/to/client.properties

# 命名空间和账号由平台提供；地址只填 origin，不包含 /nacos 等路径。
NACOS_SERVER_URL=https://nacos.company.internal
NACOS_NAMESPACE_ID=public
NACOS_GROUP=EGIS_AGENTKIT
# 如通过 Nacos 3 console 管理配置，在此填写独立 origin。
# NACOS_CONSOLE_URL=https://nacos-console.company.internal
# 按平台认证方式注入 NACOS_ACCESS_TOKEN，或成对注入以下两个变量。
# NACOS_IDENTITY_KEY=platform-header-name
# NACOS_IDENTITY_VALUE=由平台密钥系统注入

# MCP OAuth 运行时变量：由 API 进程读取，初始化脚本不会生成或写入这些凭据。
# credentialKeyEnv 默认引用 AGENTKIT_MCP_CREDENTIAL_KEY，注入持久 Fernet 密钥，各节点一致。
# AGENTKIT_MCP_CREDENTIAL_KEY=由平台密钥系统注入
# redirectUriEnv 默认引用以下变量；已有 Nacos 若为 null，需显式填入变量名。
# AGENTKIT_MCP_OAUTH_REDIRECT_URI=https://实际前端域名/connectors/oauth/callback
# 本机从 http://localhost:5179 发起授权时，可显式使用：
# AGENTKIT_MCP_OAUTH_REDIRECT_URI=http://localhost:5179/connectors/oauth/callback
# 协议、主机和端口须与浏览器一致；Nacos redirectUri 有值时优先使用它。
